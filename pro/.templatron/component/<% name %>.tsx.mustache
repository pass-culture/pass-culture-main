<%# scss.yes %>
import styles from './<% name %>.module.scss'

<%/ scss.yes %>
type <% name %>Props = {
  foo?: string
}

export const <% name %> = ({ foo }: Readonly<<% name %>Props>): JSX.Element => {
  return (
    <%# scss.yes %>
    <div className={styles['<%# toKebabCase %><% name %><%/ toKebabCase %>']}>
    <%/ scss.yes %>
    <%# scss.no %>
    <div>
    <%/ scss.no %>
      <h1><% name %> {foo ?? ''}</h1>
